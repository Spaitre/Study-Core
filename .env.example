# Copia este archivo a .env (en la raíz del proyecto) y rellena los valores.
# .env no se sube a git (ver .gitignore).

# Client ID de OAuth de Google Cloud Console (no es secreto, es seguro
# exponerlo en el frontend). Con solo esta variable alcanza: el backend
# también la lee. Déjala vacía o borra la línea para desactivar el botón
# "Iniciar sesión con Google".
VITE_GOOGLE_CLIENT_ID=

# Marca la cookie de sesión como Secure (solo en despliegue con HTTPS, p. ej.
# Railway). En local, déjala sin definir.
# COOKIE_SECURE=1
